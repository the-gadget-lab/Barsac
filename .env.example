# Copy to .env and adjust. The site runs with these defaults out of the box.

PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin for canonical/Open Graph/sitemap URLs (no trailing slash).
# Leave unset to derive it from each request (fine behind ngrok in dev).
# SITE_URL=https://www.barsac-drome.fr

# Admin login (placeholder — change before going live)
ADMIN_USER=admin
ADMIN_PASS=admin

# ── Database ─────────────────────────────────────────────
# Default: SQLite (zero setup). Swap engine by changing DB_CLIENT + the
# connection vars below — no code changes required (handled by knexfile.js).
DB_CLIENT=better-sqlite3
DB_FILE=./data/barsac.sqlite

# PostgreSQL example:
#   DB_CLIENT=pg
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_USER=barsac
#   DB_PASSWORD=secret
#   DB_NAME=barsac

# MySQL / MariaDB example:
#   DB_CLIENT=mysql2
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=barsac
#   DB_PASSWORD=secret
#   DB_NAME=barsac
