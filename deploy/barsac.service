# systemd — sudo cp deploy/barsac.service /etc/systemd/system/ && sudo systemctl enable --now barsac
[Unit]
Description=Site de la commune de Barsac (Drôme)
After=network.target

[Service]
Type=simple
User=lokman
WorkingDirectory=/home/lokman/Desktop/webkanto
Environment=PORT=3001
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
