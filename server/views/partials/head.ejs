<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <% if (locals.description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (locals.noindex) { %><meta name="robots" content="noindex,nofollow"><% } else { %><meta name="robots" content="index,follow,max-image-preview:large"><% } %>
  <% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>">
  <meta property="og:url" content="<%= canonical %>"><% } %>
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:site_name" content="Barsac en Diois — Drôme">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:title" content="<%= title %>">
  <% if (locals.description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image"><% } %>
  <% if (locals.jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, "\\u003c") %></script><% } %>
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/blog.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <div class="grain" aria-hidden="true"></div>
