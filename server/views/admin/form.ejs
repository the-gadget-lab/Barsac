<%- include('../partials/head', { bodyClass: 'admin-body' }) %>
<link rel="stylesheet" href="/assets/vendor/toastui/toastui-editor.min.css">
<%- include('../partials/admin-header') %>

<% const isEdit = post && post.id; %>
<main class="admin-wrap admin-wrap--narrow">
  <a class="back-link" href="/admin">← Retour aux articles</a>
  <h1 class="display"><%= isEdit ? 'Modifier l\'article' : 'Nouvel article' %></h1>

  <% if (typeof error !== 'undefined' && error) { %><p class="form-error"><%= error %></p><% } %>

  <form class="post-form" method="post"
        action="<%= isEdit ? '/admin/posts/' + post.id : '/admin/posts' %>"
        enctype="multipart/form-data">

    <label>Titre
      <input type="text" name="title" required value="<%= post ? post.title || '' : '' %>">
    </label>

    <label>Chapô / extrait <span class="opt">(facultatif)</span>
      <input type="text" name="excerpt" maxlength="500" value="<%= post ? post.excerpt || '' : '' %>">
    </label>

    <div class="field">
      <label for="body-field">Contenu <span class="opt">(éditeur visuel — basculez en Markdown si besoin)</span></label>
      <textarea id="body-field" name="body" rows="16" required placeholder="Rédigez votre article…"><%= post ? post.body || '' : '' %></textarea>
      <div id="md-editor"></div>
    </div>

    <div class="form-row">
      <label>Image de couverture <span class="opt">(facultatif)</span>
        <input type="file" name="cover" accept="image/*">
      </label>
      <label>Statut
        <select name="status">
          <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Brouillon</option>
          <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Publié</option>
        </select>
      </label>
    </div>

    <% if (isEdit && post.cover_image) { %>
      <div class="current-cover">
        <span>Couverture actuelle :</span>
        <img src="<%= post.cover_image %>" alt="">
        <em>Téléverser une nouvelle image la remplacera.</em>
      </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn"><%= isEdit ? 'Enregistrer' : 'Créer l\'article' %></button>
      <a class="btn btn--ghost" href="/admin">Annuler</a>
    </div>
  </form>
</main>

<script src="/assets/vendor/toastui/toastui-editor-all.min.js"></script>
<script src="/assets/vendor/toastui/i18n/fr-fr.js"></script>
<script src="/assets/js/admin-editor.js"></script>
<%- include('../partials/foot') %>
