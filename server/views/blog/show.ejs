<%- include('../partials/head') %>
<%- include('../partials/site-header') %>

<main class="blog-wrap article">
  <a class="back-link" href="/blog">← Tous les articles</a>
  <article class="post-full">
    <header class="post-full-head">
      <time class="post-date"><%= formatDate(post.published_at || post.created_at) %></time>
      <h1 class="display"><%= post.title %></h1>
      <% if (post.excerpt) { %><p class="post-full-excerpt"><%= post.excerpt %></p><% } %>
    </header>
    <% if (post.cover_image) { %>
      <figure class="post-full-cover"><img src="<%= post.cover_image %>" alt="<%= post.title %>"></figure>
    <% } %>
    <div class="prose"><%- bodyHtml %></div>
  </article>
  <a class="back-link back-link--foot" href="/blog">← Retour au journal</a>
</main>

<%- include('../partials/site-footer') %>
<%- include('../partials/foot') %>
